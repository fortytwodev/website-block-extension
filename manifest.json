{
    "manifest_version": 3,
    "name": "Website blocking extension",
    "version": "1.0",
    "description": "An extension that blocks distracting websites. By adding a website to the list, you will not be able to access it.",
    "permissions": [
        "storage",
        "declarativeNetRequest",
        "activeTab",
        "declarativeNetRequestWithHostAccess"
    ],
    "host_permissions": ["<all_urls>"],
    "action": {
      "default_popup": "src/content/index.html",
      "default_icon": {
        "48": "src/images/icon48.png",
        "128": "src/images/icon128.png"
      }
    },
    "icons": {
      "48": "src/images/icon48.png",
      "128": "src/images/icon128.png"
    },
    "content_scripts": [
    ],
    "background": {
      "service_worker": "src/scripts/background.js",
      "type": "module"
    }
  }